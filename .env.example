APP_NAME="Fanikisha"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=occasion
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
# Preferred on Railway Hobby (SMTP is blocked there): send over HTTPS via Resend.
# RESEND_API_KEY=re_xxxxxxxx
# For real emails set MAIL_MAILER=smtp plus:
# MAIL_HOST=, MAIL_PORT=587, MAIL_USERNAME=, MAIL_PASSWORD=, MAIL_SCHEME=smtp
# MAIL_FROM_ADDRESS="no-reply@fanikisha.app", MAIL_FROM_NAME="Fanikisha"

# Country code used to normalize contact phone numbers app-wide (see PhoneNumberService).
DEFAULT_COUNTRY_CODE=255

# Public business details (shown on the website, privacy policy and terms — must match your registration documents)
COMPANY_LEGAL_NAME="Fanikisha"
COMPANY_EMAIL="info@fanikisha.app"
COMPANY_PHONE=
COMPANY_ADDRESS="Dar es Salaam, Tanzania"
COMPANY_REGISTRATION=
COMPANY_PDPC_CERTIFICATE=

# SMS (Beem). Without these the app cannot send any SMS.
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=
BEEM_COST_PER_SMS=20

# WhatsApp Cloud API (Meta) — sends the invitation straight from the guest list. Optional.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Delivery reports (webhook at /webhooks/whatsapp): any long random word, and the app secret from Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_TEMPLATE_INVITE=event_invitation
# WHATSAPP_TEMPLATE_INVITE_SW=event_invitation_sw
# WHATSAPP_TEMPLATE_INVITE_CARD=event_invitation_card
# WHATSAPP_TEMPLATE_INVITE_CARD_SW=event_invitation_card_sw

# Photo/schedule import from pictures (Google Gemini). Optional.
GEMINI_API_KEY=

# WhatsApp number shown on the website and in help links (digits only, e.g. 255700000000)
COMPANY_WHATSAPP=

# Scheduled messages need this to run every minute on the host (Railway cron): php artisan schedule:run

# Behind Railway's proxy every request looks like it comes from the proxy unless client IPs are read from the forwarded header.
# '*' trusts whatever the proxy forwards. To trust only your platform's proxy addresses, list them: TRUSTED_PROXIES=10.0.0.0/8,100.64.0.0/10
TRUSTED_PROXIES=*
