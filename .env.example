APP_NAME="Fanikisha"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=occasion
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
# For real emails set MAIL_MAILER=smtp plus:
# MAIL_HOST=, MAIL_PORT=587, MAIL_USERNAME=, MAIL_PASSWORD=, MAIL_SCHEME=smtp
# MAIL_FROM_ADDRESS="no-reply@fanikisha.app", MAIL_FROM_NAME="Fanikisha"

# Country code used to normalize contact phone numbers app-wide (see PhoneNumberService).
DEFAULT_COUNTRY_CODE=255
